@startuml BionicPRO_C4_model_task2

!include <C4/C4_Container>

title BionicPRO — подготовка и получение отчётов

LAYOUT_LEFT_RIGHT()

Person_Ext(prosthesis_buyer, "Покупатель протеза")
Person_Ext(prosthesis_pilot, "Пилот протеза", "Пользователь приложения и владелец данных отчёта")

System(prosthesis_chip, "Программа в чипе протеза", "Читает миосигналы, управляет протезом и передаёт техническую телеметрию")
Container(prosthesis_app, "Приложение для донастройки протеза", "iOS / Android", "Управление протезом и запрос отчёта")
System_Ext(identity_service, "Сервис аутентификации", "OIDC / OAuth 2.0", "Выдаёт подтверждённую пользовательскую идентичность; детали потока вне этой задачи")

System_Boundary(bionicpro, "BionicPRO") {
  Container(online_store, "Интернет-магазин", "Битрикс24")
  Container(crm, "CRM", "Битрикс24", "Заказы, клиенты и связь пользователя с протезами")
  ContainerDb(crm_db, "CRM DB", "Реляционная БД", "Операционные клиентские данные")

  Container(api, "API", "Backend service", "Принимает телеметрию и предоставляет GET /reports текущему пользователю")
  ContainerDb(database, "Операционная БД", "PostgreSQL", "Телеметрия и операционные данные приложения")

  Container(airflow, "ETL-оркестратор", "Apache Airflow", "Инкрементально извлекает данные, строит и публикует отчётную витрину")
  ContainerDb(airflow_db, "Airflow Metadata DB", "PostgreSQL", "Состояние DAG, запусков и задач; без бизнес-данных")
  ContainerDb(olap_db, "OLAP и витрина отчётов", "ClickHouse", "Staging, dim_user_prosthesis, report_by_user_hour и processed_until")
}

Person(production_operator, "Оператор производства")
Person(ml_engineer, "ML-инженер")
Container(cli_tool, "CLI-инструмент ML", "Backend tool")

Rel(prosthesis_buyer, online_store, "Выбор протеза, заказ и оплата", "HTTPS")
Rel(online_store, crm, "Создаёт заказ", "HTTPS")
Rel(production_operator, crm, "Работает с заказом", "HTTPS")
Rel(crm, crm_db, "Читает и изменяет клиентские данные", "SQL / TLS")

Rel(prosthesis_pilot, prosthesis_chip, "Предоставляет миосигналы")
Rel(prosthesis_pilot, prosthesis_app, "Использует приложение")
Rel(prosthesis_app, prosthesis_chip, "Локальное управление протезом", "Bluetooth")
Rel(prosthesis_app, identity_service, "Проходит аутентификацию", "OIDC / HTTPS")
Rel(prosthesis_app, api, "Отправляет команды и запрашивает свой отчёт", "HTTPS + access token")
Rel(api, identity_service, "Проверяет пользовательскую идентичность и токен", "OIDC / HTTPS")

Rel(prosthesis_chip, api, "Отправляет техническую телеметрию", "HTTPS / device credentials")
Rel(api, database, "Записывает телеметрию и читает операционные данные", "SQL / TLS")

Rel(airflow, crm_db, "Читает инкремент клиентов и связей с протезами", "Read-only SQL / TLS")
Rel(airflow, database, "Читает инкремент телеметрии", "Read-only SQL / TLS")
Rel(airflow, olap_db, "Загружает staging, объединяет данные, публикует витрину", "Native protocol / TLS")
Rel(airflow, airflow_db, "Хранит метаданные", "SQL / TLS")

Rel(api, olap_db, "Читает готовую витрину по authenticated user_id и обработанному периоду", "Read-only SQL / TLS")

Rel(ml_engineer, cli_tool, "Запускает ML-операции")
Rel(cli_tool, database, "Читает разрешённые операционные данные", "TLS")



SHOW_LEGEND()

@enduml
